{
  "name": "@sstehniybogd/pi-ghostty",
  "version": "0.1.0",
  "description": "Automatic task titles and a working spinner in Ghostty tabs and sidebar for the Pi coding agent.",
  "type": "module",
  "license": "MIT",
  "author": "Stanislav Stehniy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sstehniy/pi-ghostty.git"
  },
  "homepage": "https://github.com/sstehniy/pi-ghostty#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "ghostty",
    "terminal",
    "sidebar",
    "spinner",
    "session-title"
  ],
  "files": [
    "extensions/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/ghostty.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "test:terminal": "python3 tests/terminal-smoke.py",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  }
}
